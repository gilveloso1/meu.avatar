{
  "name": "meu-avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vídeos curtos com avatar realista falando, para redes sociais e anúncios, gerados pelo OpenRouter. Roda no Cloudflare Workers.",
  "scripts": {
    "gerar": "tsx tools/gerar-video.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrar": "wrangler d1 migrations apply DB --remote",
    "db:migrar:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true
  }
}
