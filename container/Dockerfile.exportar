# Contêiner que monta os vídeos dos projetos (container/exportar.py): só ffmpeg
# estático e Python, para subir rápido. Antes do build: ./baixar-binarios.sh.
# A imagem base pelo digest (02/11/2026): a tag sozinha muda com o tempo, e cada deploy mudaria a imagem.
FROM mirror.gcr.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
WORKDIR /app
COPY ffmpeg /usr/local/bin/
COPY exportar.py /app/
RUN chmod +x /usr/local/bin/ffmpeg
EXPOSE 8080
CMD ["python3", "/app/exportar.py"]
