# Copie este arquivo para ".env" (sem o .example) e preencha SÓ se for usar a voz paga (ElevenLabs).
# O arquivo .env nunca é compartilhado nem enviado a lugar nenhum.
ELEVENLABS_API_KEY=
# Opcional: id da voz (também pode ser escolhido com `node tools/voz.mjs configurar-paga --voz <id>`)
ELEVENLABS_VOICE_ID=
